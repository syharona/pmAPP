# --- Serveur web
PORT=3000
# 127.0.0.1 = accessible seulement depuis ton poste. Mets 0.0.0.0 pour le réseau (APP_PASSWORD obligatoire alors).
HOST=127.0.0.1
# Mot de passe de l'interface web (laisser vide en local seul)
APP_PASSWORD=
# DB_PATH=./data/pmapp.db

# --- Telegram (capture depuis le téléphone)
# 1. Parle à @BotFather sur Telegram → /newbot → copie le token ici
TELEGRAM_BOT_TOKEN=
# 2. Démarre l'app, écris au bot : il te répond ton chat id → colle-le ici puis redémarre
TELEGRAM_ALLOWED_CHAT_IDS=
# polling (défaut, aucune URL publique) ou webhook (nécessite PUBLIC_URL + secret)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=

# --- WhatsApp (optionnel, API WhatsApp Business Cloud de Meta, URL publique requise)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# numéros autorisés au format international sans + (ex. 33612345678)
WHATSAPP_ALLOWED_NUMBERS=

# --- Mails → actions par IA (optionnel ; sans clé, heuristique locale)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Ingestion de mails depuis Power Automate / scripts (jeton Bearer)
INGEST_TOKEN=
